    {
      "parameters": {
        "jsCode": "// Получаем сырой ответ от Dify\nconst rawData = items[0].json.data; \n\n// Dify присылает данные потоком, разделяя их \"data: \"\n// Нам нужно собрать все кусочки \"answer\" воедино.\n\nlet fullText = \"\";\n\nif (typeof rawData === 'string') {\n    const lines = rawData.split('\\n');\n    \n    for (const line of lines) {\n        // Ищем строки, начинающиеся с \"data: \"\n        if (line.trim().startsWith('data:')) {\n            try {\n                // Убираем \"data: \" и парсим JSON\n                const jsonStr = line.replace('data: ', '').trim();\n                const jsonObj = JSON.parse(jsonStr);\n                \n                // Если это событие \"message\" или \"agent_message\", берем текст\n                if (jsonObj.event === 'message' || jsonObj.event === 'agent_message') {\n                    fullText += jsonObj.answer;\n                }\n            } catch (e) {\n                // Игнорируем строки, которые не являются JSON (например, пинги)\n            }\n        }\n    }\n}\n\n// Если вдруг Dify ответил обычным JSON (маловероятно, но бывает)\nif (!fullText && typeof rawData === 'object' && rawData.answer) {\n  fullText = rawData.answer;\n}\n\n// Возвращаем чистый текст для следующего узла\nreturn {\n  json: {\n    answer: fullText || \"Агент думал, но ничего не ответил.\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-112, -208],
      "id": "6f1aaaf1-c9d1-4948-9c08-ecf69db9f8b3",
      "name": "Code in JavaScript1"
    }
